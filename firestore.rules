rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@fsudmc.com' ||
          request.auth.token.email.matches('^admin.*@fsudmc\\.com$') ||
          request.auth.token.email.matches('^admin.*@.*')
        ))
      );
    }

    function isApprovedStudent() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'approved' ||
            get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active'
          )
        )
      );
    }

    // Students collection
    // - Reading is allowed for student ID lookup and campus administration
    // - Registration is permitted with status == 'pending'
    // - Normal students CANNOT change their status, approve themselves or others
    // - Only administrators can approve, reject, block or delete student accounts
    match /students/{studentId} {
      allow read: if true;
      
      allow create: if (
        request.resource.data.status == 'pending' &&
        (request.resource.data.role == 'student' || !('role' in request.resource.data))
      ) || isAdmin();

      allow update: if isAdmin() || (
        isAuthenticated() &&
        (
          (resource != null && resource.data.uid == request.auth.uid) ||
          request.auth.uid == studentId
        ) &&
        request.resource.data.status == resource.data.status &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role', 'approvedAt', 'approvedBy'])
      );

      allow delete: if isAdmin();
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
    }

    // Quizzes collection
    // Published quizzes metadata is readable
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();

      // Question subcollection
      // Questions are only readable by administrators or approved students
      match /questions/{questionId} {
        allow read: if isAdmin() || isApprovedStudent();
        allow write: if isAdmin();
      }
    }

    // Root Questions collection (Global Question Bank)
    match /questions/{questionId} {
      allow read: if isAdmin() || isApprovedStudent();
      allow write: if isAdmin();
    }

    // Quiz Sessions (Submissions & In-progress)
    // Publicly readable for /winner-list table and leaderboard, writable by students and admin
    match /quizSessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // Winners collection (Publicly visible leaderboard)
    match /winners/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    // Tie-breaks collection
    match /tieBreaks/{tieBreakId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Portal Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
