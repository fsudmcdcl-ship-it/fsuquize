rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Students collection (Open registration & admin management)
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{uid} {
      allow read, write: if true;
    }

    // Quizzes collection
    match /quizzes/{quizId} {
      allow read, write: if true;

      // Question subcollection
      match /questions/{questionId} {
        allow read, write: if true;
      }
    }

    // Quiz Sessions (Submissions & In-progress)
    match /quizSessions/{sessionId} {
      allow read, write: if true;
    }

    // Winners collection (Publicly visible leaderboard)
    match /winners/{quizId} {
      allow read, write: if true;
    }

    // Tie-breaks collection
    match /tieBreaks/{tieBreakId} {
      allow read, write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Portal Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
