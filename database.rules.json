{
  "rules": {
    ".read": true,
    ".write": true,

    "syncMeta": {
      ".read": true,
      ".write": true
    },

    "students": {
      ".indexOn": ["phone", "rollNo", "status", "uid", "studentId"],
      ".read": true,
      ".write": true,
      "$studentId": {
        ".read": true,
        ".write": true,
        "activeSessions": {
          ".read": true,
          ".write": true,
          "$deviceId": {
            ".read": true,
            ".write": true
          }
        }
      }
    },

    "quizzes": {
      ".indexOn": ["status", "createdAt"],
      ".read": true,
      ".write": true,
      "$quizId": {
        ".read": true,
        ".write": true
      }
    },

    "questions": {
      ".indexOn": ["quizId", "setNumber"],
      ".read": true,
      ".write": true
    },

    "quizSessions": {
      ".indexOn": ["studentId", "quizId", "score", "submittedAt", "status"],
      ".read": true,
      ".write": true,
      "$sessionId": {
        ".read": true,
        ".write": true
      }
    },

    "winners": {
      ".read": true,
      ".write": true,
      "$quizId": {
        ".read": true,
        ".write": true
      }
    },

    "tieBreaks": {
      ".read": true,
      ".write": true,
      "$tieBreakId": {
        ".read": true,
        ".write": true
      }
    },

    "notifications": {
      ".indexOn": ["targetType", "targetStudentId", "createdAt"],
      ".read": true,
      ".write": true,
      "$notificationId": {
        ".read": true,
        ".write": true
      }
    },

    "liveBroadcast": {
      ".read": true,
      ".write": true
    },

    "settings": {
      ".read": true,
      ".write": true,
      "portal": {
        ".read": true,
        ".write": true
      }
    },

    "auditLogs": {
      ".indexOn": ["timestamp", "action"],
      ".read": true,
      ".write": true
    },

    "admins": {
      ".read": true,
      ".write": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    }
  }
}
