{
  "rules": {
    ".read": false,
    ".write": false,

    "students": {
      ".indexOn": ["phone", "rollNo", "status", "uid", "studentId"],
      ".read": true,
      "$studentId": {
        ".read": true,
        ".write": "auth != null",
        "activeSessions": {
          ".read": true,
          "$deviceId": {
            ".read": true,
            ".write": "auth != null"
          }
        }
      }
    },

    "quizzes": {
      ".indexOn": ["status", "createdAt"],
      ".read": true,
      ".write": "auth != null",
      "$quizId": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "questions": {
      ".indexOn": ["quizId", "setNumber"],
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "quizSessions": {
      ".indexOn": ["studentId", "quizId", "score", "submittedAt", "status"],
      ".read": true,
      "$sessionId": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "winners": {
      ".read": true,
      ".write": "auth != null",
      "$quizId": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "tieBreaks": {
      ".read": true,
      ".write": "auth != null",
      "$tieBreakId": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null",
      "portal": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "auditLogs": {
      ".indexOn": ["timestamp", "action"],
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "admins": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
