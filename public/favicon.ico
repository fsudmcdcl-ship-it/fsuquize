<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#991b1b"/>
      <stop offset="100%" stop-color="#dc2626"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>
  <!-- Background Rounded Rect -->
  <rect width="64" height="64" rx="16" fill="url(#bgGrad)"/>
  <!-- Gold Outer Border Accent -->
  <rect x="2" y="2" width="60" height="60" rx="14" fill="none" stroke="#fef08a" stroke-width="1.5" stroke-opacity="0.4"/>
  <!-- Graduation Cap / Torch Symbol -->
  <path d="M32 14L50 23L32 32L14 23Z" fill="url(#goldGrad)"/>
  <path d="M20 28V38C20 42 25 45 32 45C39 45 44 42 44 38V28" fill="none" stroke="#fef08a" stroke-width="3" stroke-linecap="round"/>
  <!-- Tassel -->
  <path d="M48 24.5V36" stroke="#fbbf24" stroke-width="2" stroke-linecap="round"/>
  <circle cx="48" cy="38" r="2.5" fill="#fbbf24"/>
  <!-- Question Mark / Quiz Emblem -->
  <path d="M30 20C30 18.8954 30.8954 18 32 18C33.1046 18 34 18.8954 34 20C34 21 32 22 32 23" stroke="#991b1b" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="32" cy="25" r="0.8" fill="#991b1b"/>
  <!-- Text initials DMC FSU -->
  <text x="32" y="55" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="7.5" font-weight="900" fill="#ffffff" letter-spacing="1">DMC • FSU</text>
</svg>
